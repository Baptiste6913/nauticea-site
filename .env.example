# Formulaires (contact et projet) via Resend. Sans ces variables, le
# site fonctionne en mode degrade complet : telephones cliquables et
# envoi mailto pre-rempli depuis le client mail du prospect.
# Domaine expediteur : nauticeayachting.fr exclusivement (SPF et DKIM
# poses a la verification du domaine dans Resend, voir docs/GO-LIVE.md).
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@nauticeayachting.fr
EMAIL_FROM=site@nauticeayachting.fr

# Adresse email publique affichee sur le site (mailto, carte de visite).
# Valeur par defaut dans le code : contact@nauticeayachting.fr.
NEXT_PUBLIC_CONTACT_EMAIL=contact@nauticeayachting.fr

# Anti-bot Cloudflare Turnstile (optionnel, desactive par defaut).
# Activer les deux cles ensemble ; ajouter https://challenges.cloudflare.com
# aux directives script-src et frame-src de la CSP (next.config.ts).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Page gamme neuve (squelette) : servie uniquement si ce flag vaut 1,
# en attendant le kit media constructeur.
NEXT_PUBLIC_GAMME_NEUVE=

# Phase B : flux XML Boats Group (Open Marine), voir docs/FLUX.md.
# FEED_URL se pose en secret GitHub Actions, pas ici.

# Espace de gestion prive /gestion (telecommande du canal fiche PDF).
# Sans SESSION_SECRET ni ADMIN_EMAILS, la page repond qu'elle n'est pas
# activee : aucune connexion n'est possible.
# SESSION_SECRET : chaine aleatoire de 32 caracteres au moins, jamais
# partagee. Sa rotation invalide toutes les sessions ouvertes, c'est le
# seul moyen de revoquer un acces (voir docs/GESTION.md).
SESSION_SECRET=
# Adresses autorisees, separees par des virgules.
ADMIN_EMAILS=

# Jeton GitHub a portee fine, ce depot uniquement, permissions contents
# write, pull requests write et actions write. Il ne sort jamais du
# serveur ; sa rotation est decrite dans docs/GO-LIVE.md.
GITHUB_GESTION_TOKEN=
# Depot cible, au format proprietaire/nom.
GITHUB_GESTION_REPO=
